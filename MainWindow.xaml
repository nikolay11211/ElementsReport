<Window x:Class="dLab.General.ElementsReport.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:dLab.General.ElementsReport.Converters"
        xmlns:lang="clr-namespace:dLab.General.ElementsReport.Lang"
        xmlns:viewModels="clr-namespace:dLab.General.ElementsReport.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance viewModels:MainWindowVm}"
        Title="{x:Static lang:ElementsReport.WindowTitle}"
        Height="480" Width="540"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ElementsReport;component/Views/Style/ElementsReportStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <converters:StringToVisibilityConverter x:Key="StringToVisibility" />
        </ResourceDictionary>
    </Window.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding InitializeCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <Grid Margin="12" Background="{StaticResource SurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Style="{StaticResource Heading1}"
                   Text="{x:Static lang:ElementsReport.ElementsHeading}"
                   Margin="0,0,0,10" />

        <ComboBox Grid.Row="1"
                  Style="{StaticResource Dropdown}"
                  ItemsSource="{Binding Categories}"
                  SelectedItem="{Binding SelectedCategory,
                                         Mode=TwoWay,
                                         UpdateSourceTrigger=PropertyChanged}"
                  DisplayMemberPath="DisplayName"
                  Margin="0,0,0,10">

                <b:Interaction.Triggers>
                    <b:EventTrigger EventName="SelectionChanged">
                        <b:InvokeCommandAction Command="{Binding InitializeCommand}" />
                    </b:EventTrigger>
                </b:Interaction.Triggers>   
        </ComboBox>
        
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Margin="0,0,0,10">

                    <TextBlock
                    Style="{StaticResource Body}"
                    Text="{x:Static lang:ElementsReport.MinAreaLabel}"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0" />

                    <TextBox
                        Style="{StaticResource TextInput}"
                        Text="{Binding MinimumAreaText,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                        Width="120">

                        <b:Interaction.Triggers>
                            <b:EventTrigger EventName="TextChanged">
                                <b:InvokeCommandAction Command="{Binding FilterCommand}" />
                            </b:EventTrigger>
                        </b:Interaction.Triggers>

                    </TextBox>  
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Style="{StaticResource DangerText}"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibility}}"
                   Margin="0,0,0,10" />

        <DataGrid Grid.Row="4"
                  Style="{StaticResource ReportGrid}"
                  ItemsSource="{Binding Rows}">
            <DataGrid.Columns>
                
                <DataGridTextColumn Header="{x:Static lang:ElementsReport.TypeColumn}"
                                    Binding="{Binding Name}"
                                    Width="*" />
                <DataGridTextColumn
                                    Header="{x:Static lang:ElementsReport.LevelColumn}"
                                    Binding="{Binding LevelName}"
                                    Width="140" />
                <DataGridTextColumn Header="{x:Static lang:ElementsReport.AreaColumn}"
                                    Binding="{Binding AreaSqM, StringFormat=N2}"
                                    Width="130" />
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,12,0,0">
            <TextBlock Style="{StaticResource Caption}"
                       Text="{x:Static lang:ElementsReport.TotalLabel}"
                       Margin="0,0,8,0" />
            <TextBlock Style="{StaticResource Body}"
                       Text="{Binding TotalArea, StringFormat=N2}" />
            <TextBlock Style="{StaticResource Body}"
                       Text="{x:Static lang:ElementsReport.SquareMetersSuffix}"
                       Margin="4,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
